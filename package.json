{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:dictionary": "node --test tests/dictionary/*.test.cjs",
    "test:dictionary:browser": "node tests/dictionary/dictionaryEditor.browser.test.cjs",
    "test:world-map:browser": "node scripts/build-global-map.mjs && node --test tests/world-map/globalMapCreator.browser.test.cjs",
    "test:world-map:natural": "node scripts/build-azgaar-command-tools.mjs && node --test experiments/spherical-grid/natural-planet.test.mjs experiments/spherical-grid/natural-morphology.test.mjs experiments/spherical-grid/azgaar-command-geography.test.mjs",
    "test:world-map": "node --test tests/world-map/globalMap.test.cjs tests/world-map/worldMap.test.cjs tests/world-map/worldMapCore.test.cjs tests/world-map/worldMapRegions.test.cjs",
    "prebuild": "node scripts/build-global-map.mjs && node scripts/build-world-map.mjs",
    "predev": "node scripts/build-global-map.mjs && node scripts/build-world-map.mjs",
    "map:global": "node scripts/build-global-map.mjs",
    "map:prepare": "node scripts/prepare-world-map.mjs",
    "map:build": "node scripts/build-world-map.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-table": "9.3.1",
