    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fake-indexeddb": "6.2.4",
    "js-yaml": "4.3.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@tiptap/core": "3.27.1",
    "@tiptap/pm": "3.27.1"
  }
